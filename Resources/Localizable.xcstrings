    "sponsor_pitch_subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People type the way they always do, and Batyrma turns every word into correct Kazakh. As a supporter, your name lives on a keyboard people open dozens of times a day."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адамдар әдеттегідей жаза береді, Batyrma әр сөзді сол сәтте дұрыс қазақшаға түзетеді. Демеуші болсаңыз, атыңыз адамдар күніне ондаған рет ашатын пернетақтада тұрады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди пишут как привыкли, а Batyrma на лету превращает каждое слово в грамотный казахский. Как партнёр, вы будете на клавиатуре, которую открывают десятки раз в день."
          }
        }
      }
    },
