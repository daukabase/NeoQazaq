    "sponsor_why_safe" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust built in: Batyrma never reads, keeps or sends what people type. Your name stands next to a product people trust."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенім: Batyrma адамдардың жазғанын оқымайды, сақтамайды, ешқайда жібермейді. Атыңыз адамдар сенетін өнімнің қасында тұрады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверие: Batyrma не читает, не хранит и не отправляет то, что пишут люди. Ваше имя — рядом с продуктом, которому доверяют."
          }
        }
      }
